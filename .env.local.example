# Get these from your Supabase project's Settings → API page
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Used by server-side admin actions (Settings → API → service_role key)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic API key — for AI-drafted email composition (v4)
ANTHROPIC_API_KEY=sk-ant-...

# Google OAuth client (already configured in Supabase, but Gmail send uses these directly)
# Get these from the same OAuth credential you set up in Google Cloud Console
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...

# The Deep Dive AdsPlatform — looks up whether a lead's company is a current TDD client
# Staging: https://staging.thedeepdive.ca/wp-json/adsplatform/v1/conference/lookup
# Production: https://thedeepdive.ca/wp-json/adsplatform/v1/conference/lookup
ADSPLATFORM_LOOKUP_URL=https://staging.thedeepdive.ca/wp-json/adsplatform/v1/conference/lookup
ADSPLATFORM_API_KEY=your-adsplatform-key

# Project Hub (PM platform) — two-way sync for the Tasks tab
HUB_BASE_URL=https://hub.thedeepdive.ca
HUB_API_KEY=your-hub-key

# Shared secret the Hub uses to call our /api/conference/income endpoint for P&L
# Set the SAME value as CRM_API_KEY on the Hub side
CRM_API_KEY=generate-a-long-random-string-here

# Shared secret an external signup website (abovebeyondsummit.com, etc.) uses to
# POST /api/intake/registration. Give the SAME value to the partner running that site.
REGISTRATION_API_KEY=generate-another-long-random-string-here
